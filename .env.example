# ── NeedNet AI — environment configuration ──────────────────────────────
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER commit a real `.env`. Placeholders only here.
#
# The AI layer is strictly optional: without credentials the app runs fully
# deterministic and the UI clearly labels every output as rule-based
# fallback rather than model output.

# OpenAI-compatible endpoint configuration (server-side only).
# The key is read ONLY inside the API routes (src/app/api/ai/*); it is never
# bundled into client code, never logged, and never returned in responses.
AI_API_KEY=            # e.g. sk-... (required to enable AI; leave empty to run without AI)
AI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible /chat/completions base URL
AI_MODEL=gpt-4o-mini                    # model id understood by the endpoint above

# ── PayPilot accounts & sessions ────────────────────────────────────────
# Dedicated HMAC-SHA256 key for HttpOnly PayPilot session cookies. Required to
# use /paypilot. When unset, sessions fall back to ORDER_SIGNING_SECRET or
# PAYPAL_CLIENT_SECRET; set a long random value in production
# (e.g. `openssl rand -hex 32`). Passwords are stored only as scrypt hashes with
# a per-account salt — never plaintext.
AUTH_SIGNING_SECRET=

# Local JSON demo stores (accounts, budgets/activity/intents, orders). They
# default to ./data and fall back to a temp dir when that is not writable.
# Set explicit writable paths on a VM if you want them to survive restarts.
# These are NOT a deployed database.
# USER_STORE_DIR=
# PAYPILOT_STORE_DIR=
# ORDER_STORE_DIR=

# ── PayPal Sandbox (Phase 4 checkout) ──────────────────────────────────
# Create credentials at https://developer.paypal.com → Apps & Credentials →
# Sandbox. WITHOUT these variables the app still starts; the checkout panel
# shows an informative "not configured" state and no payment can occur or
# be faked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET= # paste your Sandbox secret here
PAYPAL_ENVIRONMENT=sandbox   # "sandbox" (default) or "live"; the browser gate refuses anything but sandbox

# Dedicated HMAC key for the stateless capture token. Optional: when unset the
# token is signed with PAYPAL_CLIENT_SECRET. Set a long random value in
# production (e.g. `openssl rand -hex 32`).
ORDER_SIGNING_SECRET=

# ── PayPal webhooks (optional but recommended) ──────────────────────────
# Create a webhook in Developer Dashboard → Apps & Credentials → your Sandbox
# app → Webhooks, with URL https://YOUR_HOST/api/paypal/webhook and the
# PAYMENT.CAPTURE.COMPLETED / PAYMENT.CAPTURE.DENIED / CHECKOUT.ORDER.APPROVED
# events. Paste the webhook id below. The route verifies EVERY request against
# PayPal's verify-webhook-signature API before touching order state; unset ⇒
# the route answers 503 and nothing is accepted unverified.
PAYPAL_WEBHOOK_ID=

# ── Agent invoicing (POST /api/agent/invoice) ────────────────────────────
# Address that the PayPal MCP `create_invoice` tool bills. Read ONLY server-side.
# The invoice is always a DRAFT: send_invoice is never called, so nothing is emailed.
# The Sandbox REST app must also have the Invoicing API enabled (Developer Dashboard
# → Apps & Credentials → your Sandbox app → Invoicing); without it the route answers
# a labelled 422 mcp_tool_error instead of pretending anything happened.
PAYPAL_INVOICE_RECIPIENT_EMAIL=   # e.g. your Sandbox buyer account email

# Rarely needed overrides (both optional):
# NEEDNET_PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com   # MCP endpoint (sandbox default)
# PAYPAL_MCP_REFRESH_TOKEN=                               # token from a completed MCP OAuth
#                                                         # consent; otherwise the client
#                                                         # credentials flow is used
