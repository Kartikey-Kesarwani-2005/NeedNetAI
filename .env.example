# ── NeedNet AI — environment configuration ──────────────────────────────
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER commit a real `.env`. Placeholders only here.
#
# The AI layer is strictly optional: without credentials the app runs fully
# deterministic and the UI clearly labels every output as rule-based
# fallback rather than model output.

# OpenAI-compatible endpoint configuration (server-side only).
# The key is read ONLY inside the API routes (src/app/api/ai/*); it is never
# bundled into client code, never logged, and never returned in responses.
AI_API_KEY=            # e.g. sk-... (required to enable AI; leave empty to run without AI)
AI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible /chat/completions base URL
AI_MODEL=gpt-4o-mini                    # model id understood by the endpoint above

# ── PayPal Sandbox (Phase 4 checkout) ──────────────────────────────────
# Create credentials at https://developer.paypal.com → Apps & Credentials →
# Sandbox. WITHOUT these variables the app still starts; the checkout panel
# shows an informative "not configured" state and no payment can occur or
# be faked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET= # paste your Sandbox secret here
PAYPAL_ENVIRONMENT=sandbox   # "sandbox" (default) or "live"; the browser gate refuses anything but sandbox
